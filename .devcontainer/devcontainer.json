{
  "name": "Nix-Bootstrapped LiteLLM Workspace",
  
  "build": {
    "dockerfile": "Dockerfile.dockerfile",
    "context": ".."
  },

  "features": {
    "ghcr.io/devcontainers/features/nix:1": {
      "version": "latest",
      "multiUser": true,
      "extraNixConfig": "experimental-features = nix-command flakes\nkeep-outputs = true\nkeep-derivations = true"
    }
  },

  "remoteUser": "vscode",
  //"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "containerEnv": {
    //"NIX_CONFIG": "experimental-features = nix-command flakes\naccept-flake-config = true\nkeep-outputs = true\nkeep-derivations = true",
    "DIRENV_LOG_FORMAT": ""
  },

  "customizations": {
    "vscode": {
      "settings": {
        "nix.enableLanguageServer": true,
        "nix.serverPath": "nixd",
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n"
      },
      "extensions": [
        "jnoortheen.nix-ide",
        "arrterian.nix-env-selector",
        "mkhl.direnv",
        "charliermarsh.ruff",
        "biomejs.biome"        
      ]
    }
  },

  "forwardPorts": [4000, 3000],
  "portsAttributes": {
    "4000": { "label": "LiteLLM Proxy API", "onAutoForward": "notify" },
    "3000": { "label": "Next.js UI", "onAutoForward": "notify" }
  },

  "postCreateCommand": ["bash", ".devcontainer/post-create.sh"]
  //"postCreateCommand": "nix develop .#fullstack -c echo '🚀 Nix Environment Provisioned!'",
  //"postCreateCommand": "bash -lc 'direnv allow . || true; nix develop .#fullstack -c true'"
  //"postAttachCommand": "direnv allow",
}